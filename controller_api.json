{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OuEstCharlie MCP Interface",
  "description": "MCP definitions for OuEstCharlie. Documents (1) the controller (Woof) MCP server interface exposed to Claude, and (2) the agent MCP server interfaces Woof invokes. Also includes shared schemas for progress notifications and logging.",
  "protocolVersion": "2025-11-25",
  "controller": {
    "description": "Woof's own MCP server, exposed to Claude Desktop as the primary interface. Claude calls these tools to manage backends, index photos, search, and open the gallery.",
    "serverInfo": {
      "name": "ouestcharlie-woof",
      "version": "0.1.0"
    },
    "capabilities": {
      "tools": {},
      "resources": {}
    },
    "tools": [
      {
        "name": "add_backend",
        "description": "Register a local folder as a photo library backend.",
        "inputSchema": {
          "type": "object",
          "required": ["name", "path"],
          "properties": {
            "name": {
              "type": "string",
              "description": "Unique label for this backend.",
              "examples": ["iCloud Photos"]
            },
            "path": {
              "type": "string",
              "description": "Absolute path to the photo root directory.",
              "examples": ["/Users/alice/Pictures"]
            }
          }
        },
        "outputSchema": {
          "type": "object",
          "required": ["name", "path", "status"],
          "properties": {
            "name": { "type": "string" },
            "path": { "type": "string" },
            "status": { "type": "string", "enum": ["added"] }
          }
        },
        "annotations": {
          "title": "Add Backend",
          "readOnlyHint": false,
          "destructiveHint": false
        }
      },
      {
        "name": "list_backends",
        "description": "List all registered photo library backends.",
        "inputSchema": {
          "type": "object",
          "properties": {}
        },
        "outputSchema": {
          "type": "object",
          "required": ["backends"],
          "properties": {
            "backends": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "type", "path"],
                "properties": {
                  "name": { "type": "string" },
                  "type": { "type": "string", "examples": ["local"] },
                  "path": { "type": "string" }
                }
              }
            }
          }
        },
        "annotations": {
          "title": "List Backends",
          "readOnlyHint": true
        }
      },
      {
        "name": "get_status",
        "description": "Get status of all registered backends and the searchable field list. Returns basic backend info (path, existence) and field definitions available for filtering in search_photos. Indexing status requires reading manifests — use get_root_manifests or index_backend.",
        "inputSchema": {
          "type": "object",
          "properties": {}
        },
        "outputSchema": {
          "type": "object",
          "required": ["backends", "fields"],
          "properties": {
            "backends": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "path", "exists"],
                "properties": {
                  "name": { "type": "string" },
                  "path": { "type": "string" },
                  "exists": { "type": "boolean" }
                }
              }
            },
            "fields": {
              "type": "array",
              "description": "Field descriptors for use in search_photos filters. Same format as Wally's list_search_fields_tool.",
              "items": {
                "type": "object",
                "required": ["name", "type", "filterFormat", "pruneable"],
                "properties": {
                  "name": { "type": "string" },
                  "type": { "type": "string" },
                  "filterFormat": { "type": "string" },
                  "pruneable": { "type": "boolean" }
                }
              }
            }
          }
        },
        "annotations": {
          "title": "Get Status",
          "readOnlyHint": true
        }
      },
      {
        "name": "get_root_manifests",
        "description": "Return the root manifest of each registered backend. The root manifest lists each top-level partition with its photo count and date/dimension summary stats. Returns null manifest for backends that are not yet indexed or unreachable.",
        "inputSchema": {
          "type": "object",
          "properties": {}
        },
        "outputSchema": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "manifest"],
            "properties": {
              "name": { "type": "string" },
              "manifest": {
                "description": "Parsed root manifest, or null if the backend is unindexed/unreachable.",
                "oneOf": [
                  {
                    "type": "object",
                    "description": "Parent manifest (top-level partitions as children).",
                    "properties": {
                      "schemaVersion": { "type": "integer" },
                      "path": { "type": "string" },
                      "children": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "path": { "type": "string" },
                            "photoCount": { "type": "integer" },
                            "dateTaken": { "type": "object" },
                            "width": { "type": "object" },
                            "height": { "type": "object" }
                          }
                        }
                      }
                    }
                  },
                  { "type": "null" }
                ]
              }
            }
          }
        },
        "annotations": {
          "title": "Get Root Manifests",
          "readOnlyHint": true
        }
      },
      {
        "name": "index_backend",
        "description": "Index photos in a backend using Whitebeard. Scans the backend for photos, writes XMP sidecars with metadata and content hashes, builds leaf manifests and parent manifests, and generates thumbnail/preview AVIF containers.",
        "inputSchema": {
          "type": "object",
          "required": ["backend_name"],
          "properties": {
            "backend_name": {
              "type": "string",
              "description": "Name of the backend to index (from list_backends)."
            },
            "partition": {
              "type": "string",
              "default": "",
              "description": "Sub-path to index (e.g. '2024/2024-07'). Defaults to '' which indexes the entire library."
            },
            "force": {
              "type": "boolean",
              "default": false,
              "description": "Re-extract EXIF and overwrite existing XMP sidecars."
            },
            "generate_thumbnails": {
              "type": "boolean",
              "default": true,
              "description": "Generate thumbnails.avif and previews.avif AVIF grids."
            },
            "extract_exif": {
              "type": "boolean",
              "default": true,
              "description": "Extract EXIF and create/update XMP sidecars. Set to false to only rebuild manifests from existing sidecars. Cannot be combined with force."
            }
          }
        },
        "outputSchema": {
          "description": "Proxied result from Whitebeard's index_library_tool or index_partition_tool.",
          "oneOf": [
            {
              "type": "object",
              "required": ["partitionsIndexed", "totalPhotos", "totalErrors"],
              "properties": {
                "partitionsIndexed": { "type": "integer" },
                "totalPhotos": { "type": "integer" },
                "totalSidecarsCreated": { "type": "integer" },
                "totalThumbnailsRebuilt": { "type": "integer" },
                "totalErrors": { "type": "integer" },
                "errorDetails": { "type": "array", "items": { "type": "string" } },
                "totalDurationMs": { "type": "integer" }
              }
            },
            {
              "type": "object",
              "required": ["error"],
              "properties": {
                "error": { "type": "string" }
              }
            }
          ]
        },
        "annotations": {
          "title": "Index Backend",
          "readOnlyHint": false,
          "destructiveHint": false
        }
      },
      {
        "name": "search_photos",
        "description": "Search photos in a backend using Wally. Traverses the manifest tree with two-level pruning for efficiency. Omitting filters (or passing null) returns all indexed photos. Use get_status to discover available filter fields and their expected formats before constructing a query.",
        "inputSchema": {
          "type": "object",
          "required": ["backend_name"],
          "properties": {
            "backend_name": {
              "type": "string",
              "description": "Name of the backend to search."
            },
            "filters": {
              "type": ["object", "null"],
              "default": null,
              "description": "Optional dict mapping field names to filter values. Call get_status to get valid fields and formats. Examples: {\"date\": {\"min\": \"2024\", \"max\": \"2024\"}, \"rating\": {\"min\": 4}}, {\"tags\": [\"vacation\"], \"make\": \"nikon\"}, {\"width\": {\"min\": 3840}}"
            },
            "root": {
              "type": "string",
              "default": "",
              "description": "Sub-path to search within the backend ('' = entire library).",
              "examples": ["2024/2024-07"]
            }
          }
        },
        "outputSchema": {
          "type": "object",
          "required": ["count", "session_token"],
          "properties": {
            "count": {
              "type": "integer",
              "description": "Total number of matching photos."
            },
            "partitions": {
              "type": "object",
              "description": "Per-partition match counts.",
              "additionalProperties": { "type": "integer" }
            },
            "session_token": {
              "type": "string",
              "description": "Opaque token to pass to browse_gallery to open the results in the gallery viewer."
            }
          }
        },
        "annotations": {
          "title": "Search Photos",
          "readOnlyHint": true
        }
      },
      {
        "name": "browse_gallery",
        "description": "Display photos from a search result in the gallery viewer. Call search_photos first, then pass its session_token here to open the gallery pre-loaded with the results.",
        "inputSchema": {
          "type": "object",
          "required": ["session_token"],
          "properties": {
            "session_token": {
              "type": "string",
              "description": "The session_token returned by search_photos."
            },
            "query_summary": {
              "type": "string",
              "default": "",
              "description": "Short human-readable description of the query shown in the gallery header (e.g. 'Nikon photos, July 2024'). Leave empty for a default title."
            }
          }
        },
        "outputSchema": {
          "type": "object",
          "required": ["matches", "backend", "querySummary", "httpPort"],
          "properties": {
            "matches": {
              "type": "array",
              "description": "Matching photo records passed to the gallery.",
              "items": { "type": "object" }
            },
            "backend": { "type": "string" },
            "querySummary": { "type": "string" },
            "httpPort": { "type": "integer" }
          }
        },
        "annotations": {
          "title": "Browse Gallery",
          "readOnlyHint": true
        }
      }
    ],
    "resources": [
      {
        "uri": "ui://gallery/ouestcharlie",
        "mimeType": "text/html;profile=mcp-app",
        "description": "Interactive gallery HTML/JS Svelte application rendered as an MCP App resource inside Claude Desktop's conversation.",
        "annotations": {
          "title": "Gallery"
        }
      }
    ]
  },
  "agents": {
    "whitebeard": {
      "serverInfo": {
        "name": "ouestcharlie-whitebeard",
        "version": "0.1.0"
      },
      "capabilities": {
        "tools": {},
        "logging": {}
      },
      "tools": [
        {
          "name": "index_partition_tool",
          "description": "Index all photos directly in a partition folder. Scans the partition for photo files (JPEG, HEIC, PNG, RAW), extracts EXIF metadata, writes XMP sidecars with ouestcharlie:contentHash and standard EXIF fields, creates/updates the leaf manifest, and generates AVIF thumbnail grids.",
          "inputSchema": {
            "type": "object",
            "required": ["partition"],
            "properties": {
              "partition": {
                "type": "string",
                "description": "Folder path relative to the backend root. Trailing slash is optional.",
                "examples": ["2024/2024-07/", "Vacations/Italy 2023/"]
              },
              "force": {
                "type": "boolean",
                "default": false,
                "description": "Re-extract EXIF and overwrite existing XMP sidecars."
              },
              "generate_thumbnails": {
                "type": "boolean",
                "default": true,
                "description": "Generate thumbnails.avif and previews.avif AVIF grids."
              },
              "extract_exif": {
                "type": "boolean",
                "default": true,
                "description": "Extract EXIF and create/update XMP sidecars. Set to false to only rebuild the manifest from existing sidecars. Cannot be combined with force."
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "required": ["partition", "photosProcessed", "errors"],
            "properties": {
              "partition": { "type": "string" },
              "photosProcessed": { "type": "integer" },
              "sidecarsCreated": { "type": "integer" },
              "sidecarsSkipped": { "type": "integer" },
              "thumbnailsRebuilt": { "type": "boolean" },
              "errors": { "type": "integer" },
              "errorDetails": { "type": "array", "items": { "type": "string" } },
              "durationMs": { "type": "integer" }
            }
          },
          "annotations": {
            "title": "Index Partition",
            "readOnlyHint": false,
            "destructiveHint": false
          }
        },
        {
          "name": "index_library_tool",
          "description": "Recursively index all photos in the library and build manifests. Walks every subfolder under root, indexes each folder containing photos as a leaf partition (creating XMP sidecars and AVIF thumbnail grids), then builds parent manifests bottom-up so every ancestor folder has an aggregate manifest summarizing its children.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "root": {
                "type": "string",
                "default": "",
                "description": "Library root relative to the backend root. Defaults to '' (the entire backend)."
              },
              "force": {
                "type": "boolean",
                "default": false,
                "description": "Re-extract EXIF and overwrite existing XMP sidecars."
              },
              "generate_thumbnails": {
                "type": "boolean",
                "default": true,
                "description": "Generate thumbnails.avif and previews.avif AVIF grids for each partition."
              },
              "extract_exif": {
                "type": "boolean",
                "default": true,
                "description": "Extract EXIF and create/update XMP sidecars. Set to false to only rebuild manifests from existing sidecars. Cannot be combined with force."
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "required": ["partitionsIndexed", "totalPhotos", "totalErrors"],
            "properties": {
              "partitionsIndexed": { "type": "integer" },
              "totalPhotos": { "type": "integer" },
              "totalSidecarsCreated": { "type": "integer" },
              "totalThumbnailsRebuilt": { "type": "integer" },
              "totalErrors": { "type": "integer" },
              "errorDetails": { "type": "array", "items": { "type": "string" } },
              "totalDurationMs": { "type": "integer" }
            }
          },
          "annotations": {
            "title": "Index Library",
            "readOnlyHint": false,
            "destructiveHint": false
          }
        }
      ]
    },
    "wally": {
      "serverInfo": {
        "name": "ouestcharlie-wally",
        "version": "0.1.0"
      },
      "capabilities": {
        "tools": {},
        "logging": {}
      },
      "tools": [
        {
          "name": "list_search_fields_tool",
          "description": "List all searchable photo fields with their types and filter formats. Returns descriptors to use when constructing the filters argument for search_photos_tool.",
          "inputSchema": {
            "type": "object",
            "properties": {}
          },
          "outputSchema": {
            "type": "object",
            "required": ["fields"],
            "properties": {
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "type", "filterFormat", "pruneable"],
                  "properties": {
                    "name": { "type": "string", "description": "Field name to use as key in filters." },
                    "type": {
                      "type": "string",
                      "enum": ["DATE_RANGE", "INT_RANGE", "STRING_COLLECTION", "STRING_MATCH", "GPS_BOX", "DESCRIPTIVE"]
                    },
                    "filterFormat": { "type": "string", "description": "Description of the expected value format." },
                    "pruneable": {
                      "type": "boolean",
                      "description": "True if this field supports partition-level pruning (faster searches on large libraries)."
                    }
                  }
                }
              }
            }
          },
          "annotations": {
            "title": "List Search Fields",
            "readOnlyHint": true
          }
        },
        {
          "name": "search_photos_tool",
          "description": "Search photos matching structured predicates. Traverses the manifest tree from root, pruning subtrees whose summary statistics exclude any possible match (two-level pruning), then scanning surviving leaf manifests entry by entry. Never reads XMP sidecars — all metadata is inline in manifests.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "filters": {
                "type": ["object", "null"],
                "default": null,
                "description": "Optional dict mapping field names to filter values. The valid fields and their formats are returned by list_search_fields_tool. Examples: photos taken in 2024 rated 4-5 stars: {\"date\": {\"min\": \"2024\", \"max\": \"2024\"}, \"rating\": {\"min\": 4, \"max\": 5}}; tagged vacation+portrait on Nikon: {\"tags\": [\"vacation\", \"portrait\"], \"make\": \"nikon\"}; 4K photos: {\"width\": {\"min\": 3840}}. Omitting a field (or passing null) is a wildcard — matches all."
              },
              "root": {
                "type": "string",
                "default": "",
                "description": "Subtree to search, relative to the backend root. Defaults to '' (entire library)."
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "required": ["matches", "partitionsScanned", "partitionsPruned", "errors", "errorDetails"],
            "properties": {
              "matches": {
                "type": "array",
                "description": "Matching photo records.",
                "items": {
                  "type": "object",
                  "required": ["partition", "filename", "contentHash", "filePath"],
                  "properties": {
                    "partition": { "type": "string" },
                    "filename": { "type": "string" },
                    "contentHash": { "type": "string", "examples": ["sha256:a1b2c3..."] },
                    "filePath": { "type": "string" },
                    "dateTaken": { "type": "string", "description": "ISO 8601 datetime." },
                    "rating": { "type": "integer" },
                    "tags": { "type": "array", "items": { "type": "string" } },
                    "tileIndex": { "type": "integer", "description": "Position in thumbnail grid photo_order." },
                    "thumbnailsPath": { "type": "string", "description": "Relative path to thumbnails.avif." },
                    "thumbnailCols": { "type": "integer", "description": "Number of columns in thumbnail grid." },
                    "thumbnailTileSize": { "type": "integer", "description": "Pixel size of each thumbnail tile." },
                    "previewsPath": { "type": "string", "description": "Relative path to previews.avif." },
                    "previewCols": { "type": "integer", "description": "Number of columns in preview grid." },
                    "previewTileSize": { "type": "integer", "description": "Pixel size of each preview tile." }
                  }
                }
              },
              "partitionsScanned": {
                "type": "integer",
                "description": "Number of leaf manifests fully evaluated."
              },
              "partitionsPruned": {
                "type": "integer",
                "description": "Number of subtrees skipped by summary pruning."
              },
              "errors": {
                "type": "integer",
                "description": "Count of manifest read failures."
              },
              "errorDetails": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          },
          "annotations": {
            "title": "Search Photos",
            "readOnlyHint": true
          }
        }
      ]
    },
    "enrichment": {
      "description": "Planned — not yet implemented.",
      "serverInfo": {
        "name": "ouestcharlie-enrichment",
        "version": "1.0.0"
      },
      "capabilities": {
        "tools": {},
        "logging": {}
      },
      "tools": [
        {
          "name": "enrich_faces",
          "description": "Detect and tag faces in photos that lack ouestcharlie:faces metadata. Reads photos for pixel analysis, writes face tags to XMP sidecars.",
          "inputSchema": {
            "type": "object",
            "required": ["backend", "partition"],
            "properties": {
              "backend": {
                "type": "string",
                "description": "Backend name from config.json"
              },
              "partition": {
                "type": "string",
                "description": "Partition path to enrich",
                "examples": ["2024/2024-07/"]
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "required": ["photosProcessed", "photosEnriched", "errors"],
            "properties": {
              "photosProcessed": { "type": "integer" },
              "photosEnriched": { "type": "integer" },
              "facesDetected": { "type": "integer" },
              "errors": { "type": "integer" }
            }
          },
          "annotations": {
            "title": "Enrich Faces",
            "readOnlyHint": false
          }
        },
        {
          "name": "enrich_scene",
          "description": "Classify scenes in photos that lack ouestcharlie:scene metadata. Reads photos for pixel analysis, writes scene tags to XMP sidecars.",
          "inputSchema": {
            "type": "object",
            "required": ["backend", "partition"],
            "properties": {
              "backend": {
                "type": "string",
                "description": "Backend name from config.json"
              },
              "partition": {
                "type": "string",
                "description": "Partition path to enrich",
                "examples": ["2024/2024-07/"]
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "required": ["photosProcessed", "photosEnriched", "errors"],
            "properties": {
              "photosProcessed": { "type": "integer" },
              "photosEnriched": { "type": "integer" },
              "errors": { "type": "integer" }
            }
          },
          "annotations": {
            "title": "Enrich Scenes",
            "readOnlyHint": false
          }
        }
      ]
    },
    "ingestion": {
      "description": "Planned — not yet implemented.",
      "serverInfo": {
        "name": "ouestcharlie-ingestion",
        "version": "1.0.0"
      },
      "capabilities": {
        "tools": {},
        "logging": {}
      },
      "tools": [
        {
          "name": "ingest_photos",
          "description": "Import photos into a backend using date-based partitioning. Computes content hash, extracts EXIF into XMP sidecar, places photo in the appropriate partition.",
          "inputSchema": {
            "type": "object",
            "required": ["backend", "source"],
            "properties": {
              "backend": {
                "type": "string",
                "description": "Target backend name from config.json"
              },
              "source": {
                "type": "string",
                "description": "Source path or URI for photos to ingest",
                "examples": ["/Users/alice/DCIM/"]
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "required": ["photosIngested", "duplicatesSkipped", "errors"],
            "properties": {
              "photosIngested": { "type": "integer" },
              "duplicatesSkipped": {
                "type": "integer",
                "description": "Photos skipped because content hash already exists in backend"
              },
              "partitionsAffected": {
                "type": "array",
                "items": { "type": "string" },
                "examples": [["2024/2024-07/", "2024/2024-08/"]]
              },
              "errors": { "type": "integer" }
            }
          },
          "annotations": {
            "title": "Ingest Photos",
            "readOnlyHint": false
          }
        }
      ]
    }
  },
  "notifications": {
    "progress": {
      "description": "Agents report progress via MCP notifications/progress on the tool call's progress token. The message field carries structured progress info.",
      "example": {
        "jsonrpc": "2.0",
        "method": "notifications/progress",
        "params": {
          "progressToken": "tool-call-123",
          "progress": 450,
          "total": 1000,
          "message": "generating thumbnails — partition 2024/2024-07/"
        }
      }
    },
    "logging": {
      "description": "Agents report non-fatal per-photo errors via MCP notifications/message at log level 'error'. The data field carries structured error info.",
      "example": {
        "jsonrpc": "2.0",
        "method": "notifications/message",
        "params": {
          "level": "error",
          "logger": "ouestcharlie-whitebeard",
          "data": {
            "category": "permanent",
            "message": "Failed to decode EXIF: truncated IFD at offset 0x1A2",
            "partition": "2024/2024-07/",
            "photo": "IMG_042.cr3",
            "operation": "EXIF extraction"
          }
        }
      }
    },
    "cancellation": {
      "description": "Woof cancels a running tool call by sending notifications/cancelled. The agent should terminate gracefully.",
      "example": {
        "jsonrpc": "2.0",
        "method": "notifications/cancelled",
        "params": {
          "requestId": "tool-call-123",
          "reason": "User cancelled"
        }
      }
    }
  },
  "errorCategories": {
    "description": "Error categories used in logging notifications and tool call errors.",
    "values": {
      "transient": "Network timeout, rate limit — Woof auto-retries (up to 3 times)",
      "permanent": "Corrupt file, unsupported format — photo skipped, flagged to user",
      "configuration": "Invalid credentials, missing permissions — agent paused until resolved"
    }
  }
}
