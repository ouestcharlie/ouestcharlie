{
  "openapi": "3.1.0",
  "info": {
    "title": "Woof Controller API",
    "description": "Localhost HTTP API for agent-to-controller communication in OuEstCharlie. Woof passes WOOF_CONTROLLER_URL (default http://127.0.0.1:19847) and WOOF_AGENT_TOKEN as environment variables when launching an agent.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:19847",
      "description": "Woof controller (localhost only)"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/heartbeat": {
      "post": {
        "summary": "Report agent progress",
        "description": "Agent reports progress during execution. Must be called at least every 5 minutes to avoid being marked as timed out by Woof.",
        "operationId": "heartbeat",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HeartbeatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Heartbeat acknowledged",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HeartbeatResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          },
          "503": {
            "$ref": "#/components/responses/ShuttingDown"
          }
        }
      }
    },
    "/v1/completed": {
      "post": {
        "summary": "Report successful completion",
        "description": "Agent reports that its task completed successfully.",
        "operationId": "completed",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompletedRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Completion acknowledged",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AckResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          },
          "503": {
            "$ref": "#/components/responses/ShuttingDown"
          }
        }
      }
    },
    "/v1/failed": {
      "post": {
        "summary": "Report fatal failure",
        "description": "Agent reports a failure that prevents further progress. The agent should terminate after this call.",
        "operationId": "failed",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FailedRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Failure acknowledged",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AckResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          },
          "503": {
            "$ref": "#/components/responses/ShuttingDown"
          }
        }
      }
    },
    "/v1/error": {
      "post": {
        "summary": "Report non-fatal per-photo error",
        "description": "Agent reports a non-fatal error for a specific photo and continues processing. Used to accumulate per-photo errors without aborting the entire run.",
        "operationId": "error",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Error acknowledged",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AckResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          },
          "503": {
            "$ref": "#/components/responses/ShuttingDown"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Unique per-run token provided by Woof at agent launch via WOOF_AGENT_TOKEN environment variable. Scoped to a single agent run. Expires when the run terminates."
      }
    },
    "schemas": {
      "HeartbeatRequest": {
        "type": "object",
        "required": ["partition", "processed", "total", "operation"],
        "properties": {
          "partition": {
            "type": "string",
            "description": "Partition path being processed",
            "examples": ["2024/2024-07/"]
          },
          "processed": {
            "type": "integer",
            "description": "Number of items processed so far",
            "examples": [450]
          },
          "total": {
            "type": "integer",
            "description": "Total items to process in this partition",
            "examples": [1000]
          },
          "operation": {
            "type": "string",
            "description": "Current operation being performed",
            "examples": ["generating thumbnails"]
          }
        }
      },
      "HeartbeatResponse": {
        "type": "object",
        "required": ["status", "shouldCancel"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ack"]
          },
          "shouldCancel": {
            "type": "boolean",
            "description": "If true, agent should terminate gracefully (user cancelled)"
          }
        }
      },
      "CompletedRequest": {
        "type": "object",
        "required": ["summary"],
        "properties": {
          "summary": {
            "$ref": "#/components/schemas/RunSummary"
          }
        }
      },
      "FailedRequest": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/AgentError"
          },
          "partialSummary": {
            "$ref": "#/components/schemas/RunSummary"
          }
        }
      },
      "ErrorRequest": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/AgentError"
          }
        }
      },
      "RunSummary": {
        "type": "object",
        "required": ["photosProcessed", "errors"],
        "properties": {
          "photosProcessed": {
            "type": "integer",
            "examples": [1023]
          },
          "sidecarsCreated": {
            "type": "integer",
            "examples": [12]
          },
          "sidecarsUpdated": {
            "type": "integer",
            "examples": [5]
          },
          "thumbnailsRebuilt": {
            "type": "boolean"
          },
          "previewsRebuilt": {
            "type": "boolean"
          },
          "manifestsUpdated": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "examples": [["2024/2024-07/.ouestcharlie/manifest.json"]]
          },
          "errors": {
            "type": "integer",
            "examples": [0]
          }
        }
      },
      "AgentError": {
        "type": "object",
        "required": ["category", "message", "operation"],
        "properties": {
          "category": {
            "type": "string",
            "enum": ["transient", "permanent", "configuration"],
            "description": "transient: network timeout, rate limit. permanent: corrupt file, unsupported format. configuration: invalid credentials, missing permissions."
          },
          "message": {
            "type": "string",
            "examples": ["Failed to decode EXIF: truncated IFD at offset 0x1A2"]
          },
          "partition": {
            "type": "string",
            "examples": ["2024/2024-07/"]
          },
          "photo": {
            "type": "string",
            "examples": ["IMG_042.cr3"]
          },
          "operation": {
            "type": "string",
            "examples": ["EXIF extraction"]
          }
        }
      },
      "AckResponse": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ack"]
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Invalid or expired bearer token"
      },
      "UnprocessableEntity": {
        "description": "Malformed request body"
      },
      "ShuttingDown": {
        "description": "Woof is shutting down — agent should terminate gracefully"
      }
    }
  }
}
